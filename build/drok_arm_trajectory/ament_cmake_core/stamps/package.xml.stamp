<?xml version="1.0"?>
<package format="3">
  <name>drok_arm_trajectory</name>

  <version>0.0.1</version>

  <description>
    ROS-independent trajectory generation library for the DROK arm.
  </description>

  <maintainer email="hgui@todo.todo">
    hgui
  </maintainer>

  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>eigen</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
